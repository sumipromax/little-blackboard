# Copy to .env. Never put account secrets in VITE_* variables.
PORT=4317
HOST=127.0.0.1
ADMIN_PASSWORD=
SESSION_SECRET=
POLYV_APP_ID=
POLYV_APP_SECRET=
POLYV_CHANNEL_ID=
# OpenAI-compatible chat/completions endpoint; requires image inputs and JSON output.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional override. Apple Silicon uses the local optional binary package.
FFMPEG_PATH=
# Comma separated extra trusted media hostname suffixes, only if required.
MEDIA_ALLOWED_HOSTS=
